<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Asked only when the driver turns the live position mode on. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <queries>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
    </queries>
    <application>
        <activity android:name="kr.routememory.coach.CoachActivity" android:exported="false" android:label="길기억 시연" />
        <activity android:name="kr.routememory.coach.LiveCoachActivity" android:exported="false" android:label="길기억 실제 위치" />
    </application>
</manifest>
